# Optional overrides for clash-verge-smart-speedtest

export CLASH_VERGE_BASE_DIR="$HOME/Library/Application Support/io.github.clash-verge-rev.clash-verge-rev"
export MIHOMO_BIN="/Applications/Clash Verge.app/Contents/MacOS/verge-mihomo"
export MIHOMO_SOCK="/tmp/verge/verge-mihomo.sock"

export CLASH_SPEEDTEST_LABEL="com.clash-verge-smart-speedtest"
export CLASH_SPEEDTEST_REPORT_LABEL="com.clash-verge-smart-speedtest-report"
export CLASH_SPEEDTEST_LAUNCH_INTERVAL="60"

export CLASH_REPORT_HOUR="9"
export CLASH_REPORT_MINUTE="5"
export CLASH_REPORT_TIMEZONE="Asia/Shanghai"

# Optional Discord delivery via OpenClaw
export CLASH_REPORT_DISCORD_CHANNEL_ID=""
export CLASH_REPORT_DISCORD_ACCOUNT="miso"
export OPENCLAW_BIN="$HOME/.npm-global/bin/openclaw"
